POSTGRES_DB=shepherd_rm
POSTGRES_USER=shepherd_rm
POSTGRES_PASSWORD=shepherd_rm_local
POSTGRES_PORT=5432

SHEPHERD_DATABASE_URL=postgresql://shepherd_rm:shepherd_rm_local@localhost:5432/shepherd_rm
SHEPHERD_DATABASE_CONNECT_TIMEOUT_SECONDS=5
SHEPHERD_MAX_REQUEST_BODY_BYTES=1048576
SHEPHERD_HOST=127.0.0.1
SHEPHERD_PORT=8000
SHEPHERD_LOG_LEVEL=INFO
SHEPHERD_LOGIN_TOKEN_TTL_SECONDS=43200
SHEPHERD_LEASE_EXPIRATION_POLL_SECONDS=1
SHEPHERD_LEASE_EXPIRATION_BATCH_SIZE=100

# Managed resource secrets require an active key ID and a JSON key ring whose
# values are base64-encoded 32-byte keys. Do not reuse this empty example.
SHEPHERD_SECRET_ENCRYPTION_ACTIVE_KEY_ID=
SHEPHERD_SECRET_ENCRYPTION_KEYS={}

# Replace this placeholder with the published linux/amd64 image digest.
SHEPHERD_IMAGE=docker.io/nassauw/shepherdrm@sha256:replace-with-published-digest
SHEPHERD_SECRETS_DIR=/etc/shepherdrm
SHEPHERD_BIND_ADDRESS=127.0.0.1
SHEPHERD_PORT=8000

POSTGRES_DB=shepherd_rm
POSTGRES_USER=shepherd_rm

SHEPHERD_DATABASE_CONNECT_TIMEOUT_SECONDS=5
SHEPHERD_LOG_LEVEL=INFO
SHEPHERD_MAX_REQUEST_BODY_BYTES=1048576
SHEPHERD_LOGIN_TOKEN_TTL_SECONDS=43200
SHEPHERD_LOGIN_RATE_LIMIT_ATTEMPTS=10
SHEPHERD_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SHEPHERD_SECRET_ACCESS_RATE_LIMIT_ATTEMPTS=60
SHEPHERD_SECRET_ACCESS_RATE_LIMIT_WINDOW_SECONDS=60
SHEPHERD_LEASE_EXPIRATION_POLL_SECONDS=1
SHEPHERD_LEASE_EXPIRATION_BATCH_SIZE=100

# Leave empty only when the key-ring file contains {} and managed secrets are disabled.
SHEPHERD_SECRET_ENCRYPTION_ACTIVE_KEY_ID=
